{
  "id": 7,
  "uid": "full-demo",
  "version": 11,
  "title": "Full featured",
  "description": "Variables, annotations, links and overrides",
  "tags": ["full"],
  "timezone": "utc",
  "weekStart": "",
  "editable": false,
  "graphTooltip": 1,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {"from": "now-12h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m"]},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {"title": "Related", "type": "dashboards", "tags": ["service"], "asDropdown": true, "includeVars": true, "keepTime": true, "icon": "external link", "tooltip": "", "url": ""},
    {"title": "Runbook", "type": "link", "url": "https://example.com/runbook", "targetBlank": true}
  ],
  "templating": {
    "list": [
      {
        "name": "datasource", "type": "datasource", "label": "Data source", "query": "prometheus",
        "current": {"selected": false, "text": "prom", "value": "prom"}, "options": [], "refresh": 1, "hide": 0
      },
      {
        "name": "cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(up, cluster)", "refId": "StandardVariableQuery"},
        "definition": "label_values(up, cluster)", "regex": "/^prod-/", "refresh": 2, "sort": 1,
        "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}, "options": []
      },
      {
        "name": "env", "type": "custom", "query": "dev,staging,prod", "multi": false, "includeAll": false,
        "current": {"selected": false, "text": "prod", "value": "prod"},
        "options": [
          {"selected": false, "text": "dev", "value": "dev"},
          {"selected": false, "text": "staging", "value": "staging"},
          {"selected": true, "text": "prod", "value": "prod"}
        ]
      },
      {
        "name": "step", "type": "interval", "query": "1m,5m,1h", "auto": true, "auto_count": 30, "auto_min": "10s",
        "current": {"text": "5m", "value": "5m"}, "options": [{"selected": true, "text": "5m", "value": "5m"}], "refresh": 2
      },
      {"name": "filters", "type": "adhoc", "datasource": {"type": "prometheus", "uid": "prom"}, "filters": [], "skipUrlSync": false}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU by pod",
      "gridPos": {"x": 0, "y": 0, "w": 16, "h": 9},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "rate(container_cpu_usage_seconds_total{cluster=~\"$cluster\"}[$__rate_interval])", "legendFormat": "{{pod}}"},
        {"refId": "B", "expr": "kube_pod_container_resource_limits{resource=\"cpu\"}", "hide": true}
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value": "cpu"}}},
        {"id": "filterByValue", "options": {"match": "any", "filters": [{"fieldName": "cpu", "config": {"id": "greater", "options": {"value": 0.1}}}]}}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"lineWidth": 1, "fillOpacity": 10}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "limit"},
            "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"showLegend": true}},
      "pluginVersion": "11.2.0",
      "links": [{"title": "Drill down", "url": "/d/other?var-cluster=${cluster}"}],
      "maxPerRow": 4,
      "repeat": "env",
      "repeatDirection": "h"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Shared latency",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 9},
      "libraryPanel": {"uid": "lib-latency", "name": "Latency"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods",
      "gridPos": {"x": 0, "y": 9, "w": 6, "h": 4},
      "interval": "1m",
      "timeFrom": "now-1h",
      "timeShift": "5m",
      "hideTimeOverride": true,
      "targets": [{"refId": "A", "expr": "count(up)", "instant": true}]
    }
  ]
}
